# ===== Application Configuration =====
APP_NAME=AlgoTrader AI
APP_VERSION=0.1.0
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ===== FastAPI Settings =====
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true  # Hot reload for development
CORS_ORIGINS=http://localhost:4200,http://localhost:4321,http://localhost:8000

# ===== Capital.com API - DEMO =====
CAPITAL_DEMO_API_URL=https://demo-api-capital.backend-capital.com
CAPITAL_DEMO_WS_URL=wss://api-streaming-capital.backend-capital.com/connect
CAPITAL_DEMO_API_KEY=your_demo_api_key_here
CAPITAL_DEMO_EMAIL=your_demo_email@example.com
CAPITAL_DEMO_PASSWORD=your_demo_password_here

# ===== Capital.com API - LIVE =====
# ATTENZIONE: Non usare in produzione senza test approfonditi su demo!
CAPITAL_LIVE_API_URL=https://api-capital.backend-capital.com
CAPITAL_LIVE_WS_URL=wss://api-streaming-capital.backend-capital.com/connect
CAPITAL_LIVE_API_KEY=your_live_api_key_here
CAPITAL_LIVE_EMAIL=your_live_email@example.com
CAPITAL_LIVE_PASSWORD=your_live_password_here

# ===== Broker Configuration =====
USE_DEMO=true  # true = demo, false = live (ATTENZIONE!)
SESSION_TIMEOUT_MINUTES=10  # Capital.com session expires after 10 minutes
MAX_RECONNECT_ATTEMPTS=5
RECONNECT_DELAY_SECONDS=5
RATE_LIMIT_REQUESTS_PER_SECOND=10  # Capital.com limit: 10 req/sec

# ===== PostgreSQL Database =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=algotrader
POSTGRES_USER=algotrader
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ===== DuckDB (Analytics) =====
DUCKDB_PATH=data/analytics.duckdb
DUCKDB_READ_ONLY=false

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
REDIS_MAX_CONNECTIONS=50

# ===== Data Pipeline =====
DATA_DIR=data/historical
PARQUET_COMPRESSION=snappy  # snappy, gzip, brotli, zstd
HISTORICAL_DATA_ASSETS=XAUUSD,BTCUSD,US500  # Gold, Bitcoin, S&P500
HISTORICAL_DATA_TIMEFRAMES=1min,5min,15min,1h,4h,1d
MAX_HISTORICAL_DAYS=730  # 2 years of data

# ===== FRED API (Federal Reserve Economic Data) =====
FRED_API_KEY=your_fred_api_key_here
FRED_SERIES=DFF,T10Y2Y,DEXUSEU,DCOILWTICO,VIXCLS  # Interest rates, yield curve, DXY, oil, VIX

# ===== Machine Learning =====
MODEL_DIR=data/models
DEVICE=cuda  # cuda, cpu, mps (Apple Silicon)
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
TRAIN_BATCH_SIZE=64
EVAL_BATCH_SIZE=128
LEARNING_RATE=0.001
EPOCHS=100
EARLY_STOPPING_PATIENCE=10

# Walk-forward optimization
TRAIN_DAYS=252  # 1 year of training data
VAL_DAYS=63     # 3 months of validation
TEST_DAYS=21    # 1 month of testing
WALK_FORWARD_STEP=21  # Retrain every month

# ===== Risk Management =====
MAX_RISK_PER_TRADE=0.02  # 2% of capital per trade
MAX_DAILY_DRAWDOWN=0.05  # 5% max daily drawdown
MAX_TOTAL_DRAWDOWN=0.15  # 15% max total drawdown
ATR_STOP_MULTIPLIER=2.0  # Stop loss = 2x ATR
ATR_TRAILING_MULTIPLIER=3.0  # Trailing stop = 3x ATR

# Position sizing
MIN_POSITION_SIZE=0.01  # Minimum lot size
MAX_POSITION_SIZE=1.0   # Maximum lot size
MAX_POSITIONS_PER_ASSET=1
MAX_TOTAL_POSITIONS=3

# ===== Trading Configuration =====
TRADING_ENABLED=false  # Master switch for live trading
PAPER_TRADING=true     # Enable paper trading mode
EXECUTION_MODE=PAPER   # PAPER (simulated) | DEMO (Capital.com demo) | LIVE (Capital.com live)
MIN_CONFIDENCE_THRESHOLD=0.65  # Minimum ML confidence to trade (0-1)
MAX_SPREAD_MULTIPLIER=1.5  # Reject trades if spread > 1.5x average

# ===== Backtesting =====
BACKTEST_INITIAL_CAPITAL=10000
BACKTEST_COMMISSION=0.0001  # 1 pip per side
BACKTEST_SLIPPAGE=0.0002    # 2 pips average slippage

# ===== Monitoring & Alerts =====
ENABLE_ALERTS=true
ALERT_EMAIL=your_email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASSWORD=your_smtp_password_here

# Telegram alerts (opzionale)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ===== Sentiment Analysis =====
# FinBERT model per sentiment analysis su news
FINBERT_MODEL=ProsusAI/finbert
SENTIMENT_CACHE_TTL_HOURS=24

# ===== Scheduler =====
ENABLE_SCHEDULER=true
DATA_COLLECTION_CRON=*/5 * * * *  # Ogni 5 minuti
MODEL_RETRAIN_CRON=0 2 * * 0      # Ogni domenica alle 2 AM
HEALTH_CHECK_CRON=*/1 * * * *     # Ogni minuto

# ===== Security =====
SECRET_KEY=your_secret_key_here_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENCRYPTION_KEY=your_encryption_key_here_32_chars_base64

# ===== Performance =====
ENABLE_PROFILING=false
MAX_WORKERS=4  # Number of worker processes
CACHE_TTL_SECONDS=300  # 5 minutes default cache
