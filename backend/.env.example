# ===== Application Configuration =====
APP_NAME=AlgoTrader AI
APP_VERSION=0.1.0
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ===== FastAPI Settings =====
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true  # Hot reload for development
CORS_ORIGINS=http://localhost:4200,http://localhost:4321,http://localhost:8000

# ===== Capital.com API - DEMO =====
CAPITAL_DEMO_API_URL=https://demo-api-capital.backend-capital.com
CAPITAL_DEMO_WS_URL=wss://api-streaming-capital.backend-capital.com/connect
CAPITAL_DEMO_API_KEY=your_demo_api_key_here
CAPITAL_DEMO_EMAIL=your_demo_email@example.com
CAPITAL_DEMO_PASSWORD=your_demo_password_here

# ===== Capital.com API - LIVE =====
# ATTENZIONE: Non usare in produzione senza test approfonditi su demo!
CAPITAL_LIVE_API_URL=https://api-capital.backend-capital.com
CAPITAL_LIVE_WS_URL=wss://api-streaming-capital.backend-capital.com/connect
CAPITAL_LIVE_API_KEY=your_live_api_key_here
CAPITAL_LIVE_EMAIL=your_live_email@example.com
CAPITAL_LIVE_PASSWORD=your_live_password_here

# ===== Broker Configuration =====
USE_DEMO=true  # true = demo, false = live (ATTENZIONE!)
SESSION_TIMEOUT_MINUTES=10  # Capital.com session expires after 10 minutes
MAX_RECONNECT_ATTEMPTS=5
RECONNECT_DELAY_SECONDS=5
RATE_LIMIT_REQUESTS_PER_SECOND=10  # Capital.com limit: 10 req/sec

# ===== PostgreSQL Database =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=algotrader
POSTGRES_USER=algotrader
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ===== DuckDB (Analytics) =====
DUCKDB_PATH=data/analytics.duckdb
DUCKDB_READ_ONLY=false

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
REDIS_MAX_CONNECTIONS=50

# ===== Data Pipeline =====
DATA_DIR=data/historical
PARQUET_COMPRESSION=snappy  # snappy, gzip, brotli, zstd
HISTORICAL_DATA_ASSETS=XAUUSD,BTCUSD,US500  # Gold, Bitcoin, S&P500
HISTORICAL_DATA_TIMEFRAMES=1min,5min,15min,1h,4h,1d
MAX_HISTORICAL_DAYS=730  # 2 years of data

# ===== External Data APIs =====
FINNHUB_API_KEY=your_finnhub_api_key_here
MARKETAUX_API_KEY=your_marketaux_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
FRED_API_KEY=your_fred_api_key_here
FRED_SERIES=DFF,T10Y2Y,DEXUSEU,DCOILWTICO,VIXCLS  # Interest rates, yield curve, DXY, oil, VIX

# ===== Signal Intelligence Layer (SIL) =====
SIL_ENABLED=false                    # Master toggle per Signal Intelligence Layer
SIL_CACHE_TTL_MINUTES=60            # Cache TTL per client SIL (minuti)
SIL_CALENDAR_GATE_ENABLED=true      # Blocca trading prima/dopo eventi high-impact
SIL_CALENDAR_MINUTES_BEFORE=30      # Minuti di blocco PRIMA di evento high-impact
SIL_CALENDAR_MINUTES_AFTER=15       # Minuti di blocco DOPO evento high-impact

# ===== Multi-Agent System (Evolution Sprint 1) =====
AGENTS_ENABLED=false                 # Master toggle for multi-agent pipeline
AGENTS_LLM_MODEL=claude-sonnet-4-20250514  # Claude model for agent reasoning
AGENTS_TEMPERATURE=0.2              # LLM temperature (low = deterministic)
AGENTS_MAX_TOKENS=2000              # Max tokens per agent LLM call
AGENTS_TECHNICAL_WEIGHT=0.4         # Weight for technical analysis in trade proposal
AGENTS_SENTIMENT_WEIGHT=0.2         # Weight for sentiment analysis
AGENTS_RISK_WEIGHT=0.4              # Weight for risk assessment
AGENTS_RISK_BLOCK_THRESHOLD=0.8     # Risk score above which trading is blocked
AGENTS_DEBATE_ENABLED=true          # Enable bull/bear debate step
ANTHROPIC_API_KEY=                   # Required when AGENTS_ENABLED=true

# ===== Reinforcement Learning (Sprint 2) =====
RL_ENABLED=false                     # Master toggle for RL system
RL_ALGORITHM=PPO                     # PPO or SAC
RL_REWARD_FUNCTION=composite         # scalping, sharpe, risk_adjusted, composite
RL_SLIDING_WINDOW_SIZE=500           # Observation window size in candles
RL_RETRAIN_INTERVAL=60               # Minutes between RL retraining cycles
RL_MAX_TRADES_PER_SESSION=20         # Max trades the RL agent can open per session
RL_TARGET_HOLD_CANDLES=10            # Target trade duration in candles
RL_MAX_DRAWDOWN_PCT=0.01             # Max drawdown fraction before episode terminates (1%)
RL_LEARNING_RATE=0.0003              # PPO/SAC learning rate (3e-4)
RL_TOTAL_TIMESTEPS=50000             # Total environment steps per training run

# ===== Memory System (Sprint 3) =====
MEMORY_ENABLED=false                 # Master toggle for 3-layer memory system
MEMORY_STM_MAX_SIGNALS=50            # Short-term memory: max recent signals kept
MEMORY_STM_MAX_TRADES=20             # Short-term memory: max recent trades kept
MEMORY_DECAY_LAMBDA=0.1              # Exponential decay rate for memory relevance
MEMORY_CONSOLIDATION_HOURS=24        # Hours between STM→LTM consolidation runs
MEMORY_EPISODIC_THRESHOLD=0.8        # Min impact score to store as episodic memory
MEMORY_DB_PATH=data/memory/mantis_memory.db  # SQLite path for LTM + episodic store

# ===== Vision AI (Sprint 4) =====
VISION_ENABLED=false                 # Master toggle for Vision AI
VISION_LLM_MODEL=claude-sonnet-4-20250514  # Claude model for chart analysis
VISION_CHART_WIDTH=1200              # Chart image width in pixels
VISION_CHART_HEIGHT=600              # Chart image height in pixels

# ===== RAG Pipeline (Sprint 4) =====
RAG_ENABLED=false                    # Master toggle for RAG pipeline
RAG_MAX_CONTEXT_TOKENS=2000          # Max tokens in RAG context string
RAG_NEWS_LOOKBACK_HOURS=4            # Hours of news to include
RAG_VECTOR_STORE_PATH=data/rag/vector_store  # FAISS index path

# ===== Machine Learning =====
MODEL_DIR=data/models
DEVICE=cuda  # cuda, cpu, mps (Apple Silicon)
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
TRAIN_BATCH_SIZE=64
EVAL_BATCH_SIZE=128
LEARNING_RATE=0.001
EPOCHS=100
EARLY_STOPPING_PATIENCE=10

# Walk-forward optimization
TRAIN_DAYS=252  # 1 year of training data
VAL_DAYS=63     # 3 months of validation
TEST_DAYS=21    # 1 month of testing
WALK_FORWARD_STEP=21  # Retrain every month

# ===== Risk Management =====
MAX_RISK_PER_TRADE=0.02  # 2% of capital per trade
MAX_DAILY_DRAWDOWN=0.05  # 5% max daily drawdown
MAX_TOTAL_DRAWDOWN=0.15  # 15% max total drawdown
ATR_STOP_MULTIPLIER=2.0  # Stop loss = 2x ATR
ATR_TRAILING_MULTIPLIER=3.0  # Trailing stop = 3x ATR

# Position sizing
MIN_POSITION_SIZE=0.01  # Minimum lot size
MAX_POSITION_SIZE=1.0   # Maximum lot size
MAX_POSITIONS_PER_ASSET=1
MAX_TOTAL_POSITIONS=3
MAX_TOTAL_EXPOSURE=1.0  # Max total notional/equity ratio (1.0 = no cap, 0.5 = 50% cap)

# ===== Trading Configuration =====
TRADING_ENABLED=false  # Master switch for live trading
PAPER_TRADING=true     # Enable paper trading mode
EXECUTION_MODE=PAPER   # PAPER (simulated) | DEMO (Capital.com demo) | LIVE (Capital.com live)
MIN_CONFIDENCE_THRESHOLD=0.65  # Minimum ML confidence to trade (0-1)
MAX_SPREAD_MULTIPLIER=1.5  # Reject trades if spread > 1.5x average

# ===== Backtesting =====
BACKTEST_INITIAL_CAPITAL=10000
BACKTEST_COMMISSION=0.0001  # 1 pip per side
BACKTEST_SLIPPAGE=0.0002    # 2 pips average slippage

# ===== Monitoring =====
ENABLE_METRICS=true  # Enable Prometheus custom metrics endpoint (/metrics)

# ===== Alerting =====
ALERTS_ENABLED=false

# Email alerts
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_SMTP_USER=your_smtp_user@gmail.com
ALERT_EMAIL_SMTP_PASSWORD=your_smtp_password_here
ALERT_EMAIL_FROM=alerts@mantis.ai
ALERT_EMAIL_TO=your_email@example.com

# Slack alerts
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Telegram alerts
ALERT_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Webhook alerts (generic)
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=

# ===== Sentiment Analysis =====
# FinBERT model per sentiment analysis su news
FINBERT_MODEL=ProsusAI/finbert
SENTIMENT_CACHE_TTL_HOURS=24

# ===== Scheduler =====
ENABLE_SCHEDULER=true
DATA_COLLECTION_CRON=*/5 * * * *  # Ogni 5 minuti
MODEL_RETRAIN_CRON=0 2 * * 0      # Ogni domenica alle 2 AM
HEALTH_CHECK_CRON=*/1 * * * *     # Ogni minuto

# ===== Security =====
SECRET_KEY=your_secret_key_here_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENCRYPTION_KEY=your_encryption_key_here_32_chars_base64

# ===== Performance =====
ENABLE_PROFILING=false
MAX_WORKERS=4  # Number of worker processes
CACHE_TTL_SECONDS=300  # 5 minutes default cache
